NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://balaji-api:PASSWORD@cluster0.xxxxx.mongodb.net/balaji?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Comma-separated site origins allowed to call the API
WEB_ORIGIN=http://localhost:5173,https://balaji-web.amitpant-05.workers.dev

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First run only: creates the owner login if none exists. Remove after first login.
ADMIN_NAME=Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: email alert for new enquiries (Gmail needs an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
